# Root-level .htaccess
# Redirect all web traffic into the public/ subdirectory
# Use this ONLY if your hosting document root is the project root (e.g., public_html/)
# If your hosting lets you set document root = public/, you don't need this file.

Options -MultiViews -Indexes
RewriteEngine On

# If hosting doc root is project root, redirect everything into public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L]
